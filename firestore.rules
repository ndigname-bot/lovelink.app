rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.creatorEmail == request.auth.token.email ||
        resourceData.creatorId == request.auth.uid ||
        resourceData.userId == request.auth.uid
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'admin@lovelink.app',
          'emmanuel@lovelink.app',
          'ndigname@gmail.com'
        ] || request.auth.token.admin == true
      );
    }

    // Match gifts collection
    match /gifts/{giftId} {
      // 1. Reading gifts
      // Anyone with the direct link can view a specific gift
      allow get: if true;

      // Only creator or admin can list/query all gifts
      allow list: if isAdmin() || (
        isAuthenticated() && resource.data.creatorEmail == request.auth.token.email
      );

      // 2. Creating gifts
      // Free testing & promo mode enabled: allow creation with paid: true
      allow create: if true;

      // 3. Updating gifts
      // - Admins can update anything (locking, unlocking, banning, moderation)
      // - Creators can update multimedia, letter, reasons, and unlock
      // - Recipients can ONLY update reaction response, lastOpened, and safety reports
      allow update: if isAdmin() ||
        isOwner(resource.data) ||
        (
          // Recipient reaction and reporting whitelist only
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'response',
            'lastOpened',
            'firstOpenedAt',
            'reported',
            'reportReason',
            'reportDetails',
            'reportedAt'
          ])
        );

      // 4. Deleting gifts
      allow delete: if isAdmin() || isOwner(resource.data);

      // Subcollections
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }

      // Group Wishes / Kudoboard squad subcollection
      match /wishes/{wishId} {
        allow read: if true;
        allow create: if request.resource.data.authorName is string && request.resource.data.message is string;
        allow update, delete: if isAdmin() || isOwner(get(/databases/$(database)/documents/gifts/$(giftId)).data);
      }
    }
  }
}
