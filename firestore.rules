rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.creatorEmail == request.auth.token.email ||
        resourceData.creatorId == request.auth.uid ||
        resourceData.userId == request.auth.uid
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'admin@lovelink.app',
          'emmanuel@lovelink.app',
          'ndigname@gmail.com'
        ] || request.auth.token.admin == true
      );
    }

    // Match gifts collection
    match /gifts/{giftId} {
      // 1. Reading gifts
      // Anyone with the direct link can view a specific gift
      allow get: if true;

      // Only creator or admin can list/query all gifts
      allow list: if isAdmin() || (
        isAuthenticated() && resource.data.creatorEmail == request.auth.token.email
      );

      // 2. Creating gifts
      // Client cannot forge paid=true on initial creation
      allow create: if request.resource.data.paid == false;

      // 3. Updating gifts
      // - Admins can update anything (locking, unlocking, banning, moderation)
      // - Creators can update multimedia, letter, and reasons
      // - Recipients can ONLY update reaction response, lastOpened, and safety reports
      allow update: if isAdmin() ||
        (
          isOwner(resource.data) &&
          // Creator cannot self-grant paid status
          (request.resource.data.paid == resource.data.paid || isAdmin())
        ) ||
        (
          // Recipient reaction and reporting whitelist only
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'response',
            'lastOpened',
            'reported',
            'reportReason',
            'reportDetails',
            'reportedAt'
          ])
        );

      // 4. Deleting gifts
      allow delete: if isAdmin() || isOwner(resource.data);

      // Subcollections
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }
    }
  }
}
